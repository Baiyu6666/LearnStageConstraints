# Startup selection; stop the workstation and restart the host GUI to switch.
ROBOT_PROFILE=iiwa14
SITE_PROFILE=lab_iiwa14

# Physical USB-to-Ethernet interface dedicated to the selected robot cabinet.
ROBOT_IFACE=enx7cc2c648b721

# Robot/FRI IP addresses and subnet belong to the selected site.json.

# Optional immutable branch/tag/commit from epfl-lasa/kuka_fri.
KUKA_FRI_REF=59af82a8524b37e08a1424a50605e7fe70f11ec9

# Motive/VRPN names, server and calibration live in the selected site profile.

# fixed: publish calibrated robot-frame scene poses; optitrack: use Motive/VRPN.
SCENE_POSE_SOURCE=fixed
