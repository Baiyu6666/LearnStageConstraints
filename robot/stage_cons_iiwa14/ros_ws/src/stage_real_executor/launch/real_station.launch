<launch>
  <param name="/stage_cons/runtime_identity" value="$(optenv STAGE_RUNTIME_IDENTITY)"/>
  <arg name="robot_name" default="$(optenv STAGE_ROBOT_NAME iiwa14)"/>
  <arg name="robot_ip" default="$(optenv ROBOT_IP 192.170.10.4)"/>
  <arg name="output_root" default="/data/demos"/>
  <arg name="velocity_scale" default="$(optenv STAGE_VELOCITY_SCALE 0.25)"/>
  <arg name="acceleration_limit_rad_s2" default="$(optenv STAGE_ACCELERATION_LIMIT 1.0)"/>

  <include file="$(find iiwa_driver)/launch/iiwa_bringup.launch">
    <arg name="robot_name" value="$(arg robot_name)"/>
    <arg name="controller" value="PositionTrajectoryController"/>
    <arg name="robot_ip" value="$(arg robot_ip)"/>
  </include>

  <group ns="$(arg robot_name)">
    <node pkg="stage_real_executor"
          type="real_executor.py"
          name="real_executor"
          output="screen"
          required="true">
      <param name="base_frame" value="$(arg robot_name)_link_0"/>
      <param name="tip_link" value="$(arg robot_name)_link_7"/>
      <param name="controller_action"
             value="/$(arg robot_name)/PositionTrajectoryController/follow_joint_trajectory"/>
      <param name="output_root" value="$(arg output_root)"/>
      <param name="velocity_scale" value="$(arg velocity_scale)"/>
      <param name="acceleration_limit_rad_s2"
             value="$(arg acceleration_limit_rad_s2)"/>
      <param name="external_torque_timeout" value="0.25"/>
    </node>
  </group>

  <include file="$(find stage_constraint_planner)/launch/task_planner.launch">
    <arg name="frame_id" value="$(arg robot_name)_link_0"/>
    <arg name="scene_pose_rotation" value="$(optenv STAGE_SCENE_ROTATION)"/>
  </include>
</launch>
